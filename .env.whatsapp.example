# WhatsApp Integration Configuration
# Copy this to your .env.local file and fill in actual values

# WhatsApp Business API Credentials
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Webhook Verification Token
# Use any random string for webhook verification
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Business WhatsApp Number (without + prefix)
# Example: 923110484849 (for +92-311-0484849)
WHATSAPP_BUSINESS_NUMBER=923110484849

# Webhook URL (for WhatsApp Cloud API setup)
# This should be accessible publicly
# Format: https://yourdomain.com/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/whatsapp/webhook

# Optional: Notification settings
WHATSAPP_ENABLE_ORDER_NOTIFICATIONS=true
WHATSAPP_ENABLE_STATUS_UPDATES=true
WHATSAPP_ENABLE_DELIVERY_RECEIPTS=true

# Optional: Logging
WHATSAPP_LOG_ENABLED=true
WHATSAPP_LOG_LEVEL=info
