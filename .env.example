# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Neon Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://username:password@host/database

# Example:
# DATABASE_URL=postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# IMAGE STORAGE CONFIGURATION
# ==========================================
# The app supports 3 storage backends:
# 1. Local Filesystem (development)
# 2. AWS S3 (production recommended)
# 3. Vercel Blob Storage (alternative)

# --- Option 1: AWS S3 (Production) ---
# Uncomment these for AWS S3 storage
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-ecom-uploads
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# --- Option 2: Vercel Blob (Production) ---
# Uncomment for Vercel Blob storage (auto-set by Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_h9Fj1G8nxbLGIlsD_0za3jYcarUSC0SysmFYY7wssQJG6S5

# --- Option 3: Local Filesystem (Development) ---
# Uncomment for local file storage (default in development)
# UPLOAD_DIR=./public/uploads

# If none of the above are set, local filesystem will be used

# ==========================================
# FACEBOOK MARKETING & CONVERSIONS API
# ==========================================
# Meta Pixel ID for client-side tracking
META_PIXEL_ID=your_pixel_id

# Access token for Facebook Conversions API (server-side tracking)
# Get from: https://business.facebook.com/settings/system-users
# Create a system user and generate a token with 'ads_management' permission
META_CONVERSIONS_API_TOKEN=your_conversions_api_token

# Alternative: Use your main access token (if META_CONVERSIONS_API_TOKEN is not set)
META_ACCESS_TOKEN=your_facebook_access_token

# Optional: Test event code for validating events before going live
# Get from: Events Manager > Test Events
# META_TEST_EVENT_CODE=TEST12345

